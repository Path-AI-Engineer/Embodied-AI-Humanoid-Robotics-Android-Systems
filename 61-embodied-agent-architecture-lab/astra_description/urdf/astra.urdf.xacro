<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="astra_synthetic_v1">
  <xacro:arg name="controllers_file" default="$(find astra_description)/config/controllers.yaml"/>
  <xacro:macro name="simple_link" params="name mass sx sy sz">
    <link name="${name}">
      <visual><geometry><box size="${sx} ${sy} ${sz}"/></geometry></visual>
      <collision><geometry><box size="${sx} ${sy} ${sz}"/></geometry></collision>
      <inertial><mass value="${mass}"/><origin xyz="0 0 0"/>
        <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
      </inertial>
    </link>
  </xacro:macro>
  <link name="base_footprint"/>
  <xacro:simple_link name="base_link" mass="20" sx="0.55" sy="0.42" sz="0.24"/>
  <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/></joint>
  <link name="left_wheel_link"><visual><geometry><cylinder radius="0.09" length="0.04"/></geometry></visual><collision><geometry><cylinder radius="0.09" length="0.04"/></geometry></collision><inertial><mass value="0.8"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
  <link name="right_wheel_link"><visual><geometry><cylinder radius="0.09" length="0.04"/></geometry></visual><collision><geometry><cylinder radius="0.09" length="0.04"/></geometry></collision><inertial><mass value="0.8"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial></link>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel_link"/><origin xyz="0 0.23 -0.07" rpy="1.5708 0 0"/><axis xyz="0 0 1"/></joint>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel_link"/><origin xyz="0 -0.23 -0.07" rpy="1.5708 0 0"/><axis xyz="0 0 1"/></joint>
  <xacro:simple_link name="arm_base_link" mass="2" sx="0.18" sy="0.18" sz="0.10"/>
  <joint name="arm_base_fixed" type="fixed"><parent link="base_link"/><child link="arm_base_link"/><origin xyz="0 0 0.2"/></joint>
  <xacro:macro name="arm_segment" params="number parent axis">
    <xacro:simple_link name="arm_link_${number}" mass="0.7" sx="0.07" sy="0.07" sz="0.17"/>
    <joint name="arm_joint_${number}" type="revolute"><parent link="${parent}"/><child link="arm_link_${number}"/><origin xyz="0 0 0.14"/><axis xyz="${axis}"/><limit lower="-1.5" upper="1.5" effort="12" velocity="0.5"/></joint>
  </xacro:macro>
  <xacro:arm_segment number="1" parent="arm_base_link" axis="0 0 1"/>
  <xacro:arm_segment number="2" parent="arm_link_1" axis="0 1 0"/>
  <xacro:arm_segment number="3" parent="arm_link_2" axis="0 1 0"/>
  <xacro:arm_segment number="4" parent="arm_link_3" axis="1 0 0"/>
  <xacro:arm_segment number="5" parent="arm_link_4" axis="0 1 0"/>
  <xacro:arm_segment number="6" parent="arm_link_5" axis="1 0 0"/>
  <xacro:simple_link name="tool0" mass="0.3" sx="0.10" sy="0.07" sz="0.07"/>
  <joint name="tool_mount" type="fixed"><parent link="arm_link_6"/><child link="tool0"/><origin xyz="0 0 0.13"/></joint>
  <xacro:simple_link name="gripper_left" mass="0.1" sx="0.08" sy="0.02" sz="0.04"/>
  <xacro:simple_link name="gripper_right" mass="0.1" sx="0.08" sy="0.02" sz="0.04"/>
  <joint name="gripper_left_mount" type="fixed"><parent link="tool0"/><child link="gripper_left"/><origin xyz="0 0.04 0.06"/></joint>
  <joint name="gripper_right_mount" type="fixed"><parent link="tool0"/><child link="gripper_right"/><origin xyz="0 -0.04 0.06"/></joint>
  <xacro:simple_link name="camera_link" mass="0.1" sx="0.08" sy="0.10" sz="0.04"/>
  <joint name="camera_mount" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.36 0 0.30"/></joint>
  <link name="camera_optical_frame"/><joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin xyz="0.08 0 0" rpy="-1.5708 0 -1.5708"/></joint>
  <xacro:simple_link name="lidar_link" mass="0.1" sx="0.07" sy="0.07" sz="0.04"/>
  <joint name="lidar_mount" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.30 0 0.18"/></joint>
  <link name="imu_link"/><joint name="imu_mount" type="fixed"><parent link="base_link"/><child link="imu_link"/></joint>
  <link name="bumper_link"/><joint name="bumper_mount" type="fixed"><parent link="base_link"/><child link="bumper_link"/><origin xyz="0.29 0 0"/></joint>
  <xacro:macro name="arm_control" params="number">
    <joint name="arm_joint_${number}">
      <command_interface name="position"><param name="min">-1.5</param><param name="max">1.5</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>
  <ros2_control name="AstraArmSim" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:arm_control number="1"/>
    <xacro:arm_control number="2"/>
    <xacro:arm_control number="3"/>
    <xacro:arm_control number="4"/>
    <xacro:arm_control number="5"/>
    <xacro:arm_control number="6"/>
  </ros2_control>
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <ros><remapping>/robot_description:=/astra/robot_description</remapping></ros>
    </plugin>
  </gazebo>
  <gazebo reference="camera_link"><sensor name="head_rgbd" type="rgbd_camera"><pose>0.08 0 0 0 0 0</pose><always_on>true</always_on><update_rate>15</update_rate><topic>/astra/sensors/rgbd</topic><gz_frame_id>camera_optical_frame</gz_frame_id><camera><horizontal_fov>1.047</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.1</near><far>8.0</far></clip></camera></sensor></gazebo>
  <gazebo reference="lidar_link"><sensor name="lidar_2d" type="gpu_lidar"><always_on>true</always_on><update_rate>10</update_rate><topic>/astra/sensors/scan</topic><lidar><scan><horizontal><samples>360</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.1</min><max>10.0</max></range></lidar></sensor></gazebo>
  <gazebo reference="imu_link"><sensor name="imu" type="imu"><always_on>true</always_on><update_rate>50</update_rate><topic>/astra/sensors/imu</topic></sensor></gazebo>
  <gazebo><plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>0.46</wheel_separation><wheel_radius>0.09</wheel_radius><topic>/astra/control/cmd_vel</topic><odom_topic>/astra/sensors/odom</odom_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><cmd_vel_timeout>0.25</cmd_vel_timeout></plugin></gazebo>
</robot>
