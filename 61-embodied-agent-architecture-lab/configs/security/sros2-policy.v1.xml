<?xml version="1.0" encoding="UTF-8"?>
<policy version="0.2.0">
  <enclaves>
    <enclave path="/astra/safety">
      <profiles>
        <profile ns="/" node="safety_gateway">
          <topics publish="ALLOW">
            <topic>rosout</topic><topic>/parameter_events</topic>
            <topic>/astra/control/authorized_cmd_vel</topic>
            <topic>/astra/safety/state</topic><topic>/astra/safety/faults</topic>
          </topics>
          <topics subscribe="ALLOW">
            <topic>/clock</topic><topic>/parameter_events</topic>
            <topic>/astra/sensors/scan</topic><topic>/astra/control/intent</topic>
            <topic>/astra/safety/estop</topic><topic>/astra/safety/arm</topic>
            <topic>/astra/safety/recovery</topic>
          </topics>
          <services reply="ALLOW" request="ALLOW">
            <service>~/describe_parameters</service><service>~/get_parameter_types</service>
            <service>~/get_parameters</service><service>~/list_parameters</service>
            <service>~/set_parameters</service><service>~/set_parameters_atomically</service>
            <service>~/get_type_description</service>
          </services>
        </profile>
        <profile ns="/" node="security_listener">
          <topics publish="ALLOW"><topic>rosout</topic><topic>/parameter_events</topic></topics>
          <topics subscribe="ALLOW"><topic>/parameter_events</topic><topic>/astra/control/authorized_cmd_vel</topic></topics>
          <services reply="ALLOW" request="ALLOW"><service>~/get_type_description</service></services>
        </profile>
        <profile ns="/" node="security_authorized_publisher">
          <topics publish="ALLOW"><topic>rosout</topic><topic>/parameter_events</topic><topic>/astra/control/authorized_cmd_vel</topic></topics>
          <topics subscribe="ALLOW"><topic>/parameter_events</topic></topics>
          <services reply="ALLOW" request="ALLOW"><service>~/get_type_description</service></services>
        </profile>
      </profiles>
    </enclave>
    <enclave path="/astra/unauthorized">
      <profiles>
        <profile ns="/" node="unauthorized_publisher">
          <topics publish="ALLOW"><topic>rosout</topic><topic>/parameter_events</topic></topics>
          <topics subscribe="ALLOW"><topic>/parameter_events</topic></topics>
          <services reply="ALLOW" request="ALLOW">
            <service>~/describe_parameters</service><service>~/get_parameter_types</service>
            <service>~/get_parameters</service><service>~/list_parameters</service>
            <service>~/set_parameters</service><service>~/set_parameters_atomically</service>
            <service>~/get_type_description</service>
          </services>
        </profile>
      </profiles>
    </enclave>
  </enclaves>
</policy>
